# Copy to .env (never commit .env). All settings are optional.

# simulation = PX4 SITL with operator commands | monitor = PX4 SITL read-only | replay = recorded flight
AEGIS_MODE=simulation

# Required to send commands. Choose your own value; if unset, a random token is
# generated at startup and printed in the backend log.
AEGIS_OPERATOR_TOKEN=change-me

# AEGIS_PX4_URL=udpin://0.0.0.0:14540
# AEGIS_REPLAY_FILE=data/sample/demo1_survey_sih.jsonl
# AEGIS_REPLAY_SPEED=1.0
# AEGIS_RECORD_FLIGHTS=true

# --- Perception (optional) ---------------------------------------------------
# none | stream (Gazebo camera bridge or scripts/stream_video.py) | video:/path/to/file.mp4
# AEGIS_CAMERA=stream
# AEGIS_DETECTOR_MODEL=models/yolo11n.onnx
# AEGIS_DETECTOR_CONFIDENCE=0.35
# AEGIS_DETECTOR_LABELS=["person","car","truck","bus","dog"]
# AEGIS_DETECTOR_THREADS=0        # 0 = half the cores, at most 4

# --- Scenario and session replay ----------------------------------------------
# AEGIS_SCENARIO=urban            # open_field (default) or urban; match run_px4.sh's 2nd argument
# AEGIS_MODE=replay
# AEGIS_REPLAY_SESSION=latest     # or a directory name under data/generated/sessions

# --- Navigation and mapping (optional) ----------------------------------------
# AEGIS_DEPTH=raycast             # none | raycast (software sensor) | stream (Gazebo depth bridge)
# AEGIS_NAV_CLEARANCE_M=3.0
# AEGIS_NAV_USE_PRIOR_MAP=true    # false = rely on sensing alone (for the replanning demo)
# AEGIS_NAV_AUTO_HOLD=true
# AEGIS_THERMAL=model             # none | model (software thermal camera; needs a scenario with a search_area)
# AEGIS_SAR_ALTITUDE_M=25.0
# AEGIS_SAR_OVERLAP=0.2
# AEGIS_NAV_LOAD_MAP=data/generated/sessions/<timestamp>/map.npz
