  "requirements": [
    {
      "id": "R-SAFE-1",
      "safety_critical": true,
      "statement": "AEGIS sends no command to an autopilot that has not proved it is a simulator.",
      "verified_by": [
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_px4_attestation.py::test_unknown_airframe_is_refused"
        },
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_px4_attestation.py::test_real_hardware_sharing_a_simulation_airframe_number_is_refused"
        },
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_px4_attestation.py::test_recheck_revokes_when_the_vehicle_is_no_longer_a_simulator"
        },
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_hardware.py::test_physical_autopilot_cannot_be_commanded_in_any_mode"
        }
      ]
    },
    {
      "id": "R-SAFE-2",
      "safety_critical": true,
      "statement": "Physical flight control cannot be enabled by configuration.",
      "verified_by": [
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_api.py::test_physical_mode_cannot_be_configured"
        },
        {
