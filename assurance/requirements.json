      "safety_critical": true,
      "statement": "Replayed data is labelled replayed and keeps the provenance it was recorded with.",
      "verified_by": [
        {
          "kind": "unit_test",
          "ref": "backend/tests/test_recording.py::test_replay_relabels_provenance_and_advances"
