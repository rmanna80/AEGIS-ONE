# Keeps the MAVSDK control ports closed to other computers across reboots.
# See scripts/lock_mavsdk_port.sh for what the rule does.
#
# Install (replace USER and the path if your checkout is elsewhere):
#   sudo cp deploy/aegis-firewall.service /etc/systemd/system/
#   sudo sed -i "s/USER/$(whoami)/g" /etc/systemd/system/aegis-firewall.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aegis-firewall
# Remove:
#   sudo systemctl disable --now aegis-firewall && sudo rm /etc/systemd/system/aegis-firewall.service
[Unit]
Description=AEGIS: MAVSDK control ports reachable from this computer only
After=nftables.service
Before=aegis-backend.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/env bash /home/USER/AEGIS-ONE/scripts/lock_mavsdk_port.sh
ExecStop=/usr/bin/env bash /home/USER/AEGIS-ONE/scripts/lock_mavsdk_port.sh --remove

[Install]
WantedBy=multi-user.target
