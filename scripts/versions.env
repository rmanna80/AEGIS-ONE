# Single source of truth for pinned upstream versions (sourced by the scripts).
PX4_VERSION=v1.17.0          # latest stable PX4 tag at project start (Nov 2026)
PX4_MSGS_BRANCH=release/1.17 # px4_msgs branch matching the firmware (used from Phase 2)
ROS_DISTRO_PIN=jazzy         # ROS 2 Jazzy on Ubuntu 24.04 (PX4's recommended pairing)
GAZEBO_RELEASE=harmonic      # Gazebo Harmonic LTS (installed by PX4's ubuntu.sh)
PX4_DIR="${PX4_DIR:-$HOME/PX4-Autopilot}"
